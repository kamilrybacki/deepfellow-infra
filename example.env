DF_INFRA_ADMIN_API_KEY=ADMIN
DF_COMPOSE_PREFIX=df_

# Docker subnet (CIDR) to attach service containers to, e.g. "172.30.0.0/24". Leave unset to run
# containers without a dedicated subnet (services are reached via their published ports instead).
DF_DOCKER_SUBNET=

# Where persistent data (config.json, models, per-service storage) is kept. Leave unset to default
# to ./storage next to the app.
DF_STORAGE_DIR=

# Where per-service storage lives. Leave unset to default to <DF_STORAGE_DIR>/services.
DF_STORAGE_SERVICES_DIR=

# Docker Hub token, used to authenticate image pulls and avoid Docker Hub's anonymous pull rate
# limit. Leave unset to pull anonymously.
DF_DOCKER_HUB_TOKEN=

# Safety margin applied on top of the calculated VRAM estimate for Ollama models, since Ollama
# doesn't report a real per-instance overhead figure. Unlike every other setting on this page,
# this is read by its bare name below (no DF_ prefix).
OLLAMA_VRAM_OVERHEAD_FACTOR=1.0

# Legacy: prefix prepended to service container names (e.g. "df_" -> "df_ollama"). Leave empty on new
# installs - container names then get the per-instance DF_CONTAINER_NAME_SUFFIX instead, which avoids
# name clashes between DF Infra instances on the same Docker host. The suffix is auto-generated only on a
# brand-new install; an existing install that drops this prefix has no suffix until one is set via
# /admin/config. While set, this prefix takes priority and the suffix is ignored. To remove it from an
# existing install, first start this version once with it still set (that pins the current container
# names in services.json), then remove it and restart - installed containers keep their names.
DF_CONTAINER_NAME_PREFIX=

# Everything else that used to live here (DF_NAME, DF_INFRA_URL, DF_MESH_KEY, DF_INFRA_API_KEY,
# DF_CONNECT_TO_MESH_URL, DF_HUGGING_FACE_TOKEN, DF_METRICS_USERNAME, DF_OTEL_*, DF_MCP_SSE_*,
# DF_STANDARD_PROXY_TIMEOUT_SECONDS, DF_CONTAINER_NAME_SUFFIX, etc.) is now dynamic runtime
# config, managed via the GET/PUT /admin/config API and persisted to config.json — not read
# from .env. Setting one of these as an environment variable only has effect once, to seed
# config.json before it first exists; after that, use the API.

# Debug-only: uncomment to simulate hardware without a supported GPU / without AVX-512, e.g. to
# exercise the sglang/vllm "hardware doesn't support this service" gating without matching real
# hardware. Read once at process start; restart the server after changing.
# DF_DEBUG_FORCE_NO_GPU=true
# DF_DEBUG_FORCE_NO_AVX512=true

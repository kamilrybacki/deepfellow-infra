DF_INFRA_ADMIN_API_KEY=ADMIN
DF_CONTAINER_NAME_PREFIX=df_

# Everything else that used to live here (DF_NAME, DF_INFRA_URL, DF_MESH_KEY, DF_INFRA_API_KEY,
# DF_CONNECT_TO_MESH_URL, DF_HUGGING_FACE_TOKEN, DF_METRICS_USERNAME, DF_OTEL_*, DF_MCP_SSE_*,
# etc.) is now dynamic runtime config, managed via the GET/PUT /admin/config API and persisted
# to config.json — not read from .env.

# Debug-only: uncomment to simulate hardware without a supported GPU / without AVX-512, e.g. to
# exercise the sglang/vllm "hardware doesn't support this service" gating without matching real
# hardware. Read once at process start; restart the server after changing.
# DF_DEBUG_FORCE_NO_GPU=true
# DF_DEBUG_FORCE_NO_AVX512=true
